# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Environment & secrets — NEVER commit these
.env
.env.local
*.env.local
# Vite/Next per-mode overrides: `.env.development.local` does NOT match
# `*.env.local`, so cockpit/.env.development.local sat untracked and
# UN-ignored — one `git add -A` from being published.
.env.*.local
*.env.*.local
agent/config.yaml
# Timestamped hand-made backups of the live config carry the same Fyers and
# cloud credentials as the original. `agent/config.yaml` alone does not match
# `agent/config.yaml.bak-20260716`.
agent/config.yaml.*
!agent/config.yaml.example
*.bak
*.bak-*

# IDE
.vscode/
.idea/
*.swp

# Testing
.pytest_cache/
.coverage
htmlcov/

# Node / Cockpit
cockpit/node_modules/
cockpit/dist/
cockpit/.next/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local data caches (large, re-fetchable — see core/options/vrp/bhavcopy.py)
data_cache/

# Docker
.docker/

# Obsidian vault — the NOTES are tracked (they are strategy definitions the
# audit gates read, and the VM gets them via git pull), but Obsidian's own
# per-machine config is not: workspace.json rewrites itself every time a pane
# moves, which would make every session a dirty working tree.
obsidian_vault/**/.obsidian/
obsidian_vault/**/.trash/
