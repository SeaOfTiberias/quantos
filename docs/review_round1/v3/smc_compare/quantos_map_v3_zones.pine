//@version=6
// QuantOS market map v3 zones, frozen as of 2026-11-13 (daily bars to 2026-11-12), for a side-by-side with an SMC indicator.
// Generated from core/market_map (code f7bfa2b, definitions docs/MARKET_MAP_DEFINITIONS_V3.md). Untested markers, not signals.
// Covers KEI, DMART, HDFCBANK, KOTAKBANK only; other symbols draw nothing. Prices are split-adjusted, as TradingView's.
indicator("QuantOS map v3 zones (2026-11-13)", overlay = true, max_boxes_count = 200)
showOrdinary = input.bool(true, "Show ordinary (non-strong) zones")
showLabels   = input.bool(true, "Show zone text")
BULL = #2a78d6
BEAR = #eb6834
NEU  = #8a8984
z(int t, float lo, float hi, color c, bool strong, bool fvg, string txt) =>
    if strong or showOrdinary
        box.new(t, hi, t + 86400000, lo, xloc = xloc.bar_time, extend = extend.right,
                 bgcolor = color.new(c, strong ? 65 : fvg ? 88 : 85), border_color = color.new(c, strong ? 0 : 60),
                 border_width = strong ? 2 : 1, border_style = fvg ? line.style_dashed : line.style_solid,
                 text = showLabels ? txt : "", text_size = size.tiny, text_color = color.new(#52514e, 0),
                 text_halign = text.align_right, text_valign = text.align_center)
var bool done = false
if barstate.islast and not done
    done := true
    if syminfo.ticker == "KEI"
        z(timestamp("Asia/Kolkata", 2023, 8, 1, 9, 15), 2223.0, 2719.9, BULL, false, false, "2223-2719.9 M bull OB, W swing, W multi-touch")
