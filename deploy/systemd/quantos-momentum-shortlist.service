[Unit]
Description=QuantOS Momentum + Base Quality Shortlist (discretionary review, no execution path)
After=network-online.target
Wants=network-online.target

# Ordering only, not a dependency: when quantos-token-refreshed.target
# pulls the whole batch in at once, this keeps the jobs single-file instead
# of letting them race. The VM has 956MB of RAM and no MemoryMax on any of
# these units, and on a quarter boundary the rotation jobs each fetch a
# few hundred symbol series at the same time the shortlist is fetching 500
# -- the exact shape of the 2026-07-15 OOM. Cheapest day-to-day too: the
# probe is ~5s and the rotation jobs no-op in ~2s off-boundary, so the
# shortlist still starts within seconds of the refresh.
# A failed or ExecCondition-skipped predecessor still releases the barrier.
After=quantos-paper-momentum.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/run_momentum_shortlist.py
Environment=HOME=/home/ubuntu

# Run at most once per calendar day, whichever trigger gets here first.
# There are now two: quantos-token-refreshed.path (fires the moment the
# daily Fyers token is refreshed) and .timer (02:15 UTC, kept as the fallback
# for a day the token watch misses). Without this guard a normal morning --
# refresh at 01:41, timer at 02:15 -- would run the same ~11 minute, ~580
# symbol scan twice for one set of EOD bars.
#
# ExecStartPost only runs when ExecStart SUCCEEDED, which is what makes this
# safe: a run that dies on an expired token writes no stamp, so the next
# trigger is still allowed to retry. Only a genuinely completed run suppresses
# the rest of the day.
#
# The same condition also enforces Mon-Fri. The .timer already does this via
# OnCalendar, but the .path unit cannot -- systemd path units have no
# day-of-week filter -- so a weekend token refresh would otherwise trigger a
# pointless ~11 minute scan that just re-ranks Friday's EOD bars.
#
# Weekday and stamp are both evaluated in IST, not UTC: the thing being gated
# is an NSE trading day. It matches in practice for a normal ~02:00 UTC
# refresh (07:30 IST, same date), but an unusually late-evening UTC refresh
# is already the next trading day in Indian time, and should be treated as one.
#
# To force a re-run by hand (new universe file, debugging a ranking):
#     rm -f ~/.quantos/last_shortlist_run && sudo systemctl start quantos-momentum-shortlist.service
# Starting the unit without clearing the stamp is a deliberate no-op, not a
# failure -- systemctl reports success and the log stays silent. On a weekend
# the weekday test blocks even that, so bypass systemd entirely:
#     cd ~/quantos && .venv/bin/python scripts/run_momentum_shortlist.py
ExecCondition=/bin/sh -c '[ "$(TZ=Asia/Kolkata date +%%u)" -le 5 ] && [ "$(cat /home/ubuntu/.quantos/last_shortlist_run 2>/dev/null)" != "$(TZ=Asia/Kolkata date +%%F)" ]'
ExecStartPost=/bin/sh -c 'TZ=Asia/Kolkata date +%%F > /home/ubuntu/.quantos/last_shortlist_run'

# No Restart= here deliberately, same reasoning as quantos-paper-momentum.service:
# the most likely failure is a stale Fyers auth token, which needs a human to
# refresh interactively. Harmless to fail silently until the next day's run --
# this produces a fresh review list, not a position or a gated boundary, so
# there is no "missed window" to lose the way a rebalance would.
