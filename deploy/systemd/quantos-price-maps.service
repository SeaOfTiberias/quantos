[Unit]
Description=QuantOS price maps -- rebuilds the swing / volume-profile / pivot map of every F&O stock, open position and watched stock (no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/price_map.py --positions --watch --fno --pause 1
Environment=HOME=/home/ubuntu
TimeoutStartSec=40min
ExecCondition=/bin/sh -c '[ "$(TZ=Asia/Kolkata date +%%u)" -le 5 ]'
