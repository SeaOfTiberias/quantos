[Unit]
Description=QuantOS candidate 20 (Good Night scalper) real at-open window liquidity probe (read-only, no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/probe_goodnight_openwindow.py
Environment=HOME=/home/ubuntu

# One-off feasibility check, NOT a recurring production job -- see the
# .timer for the 3 specific one-time fires. Depends on the VM's Fyers
# token already being freshly refreshed before it fires (same daily
# manual refresh every other morning job here relies on) -- a stale
# token fails this run harmlessly (no orders, self-healing: just re-run
# manually, or wait for a future trading day if this one is missed).
#
# No market-hours ExecCondition here (unlike quantos-orb-spread-probe.
# service/quantos-orb-stopout-probe.service): the .timer's OnCalendar
# entries are already absolute one-time timestamps pinned to a specific
# real trading morning, not a recurring daily rule that needs its own
# guard.
