# ══════════════════════════════════════════════════════════════════════
# RETIRED ON THE VM 2026-09-30 — deliberately, do not re-enable casually.
#
# Candidate 11's real-capital pilot. Its only job was to prove the live
# order path end to end; the strategy's actual evidence is the paper
# walk-forward (quantos-paper-momentum), which keeps running. In two
# quarter fires it never completed one real order, and both fired
# PRE-MARKET (07:18-07:50 IST, the token-refresh batch runs before the
# 09:15 open):
#   - Q2 (2026-07-29): every CNC order bounced by Fyers RMS 16387.
#   - Q3 (2026-09-30): stopped by hand before placing anything, because
#     since c0b5b90 place_order() reads Fyers' pre-market ack (s=ok) as
#     success, the RMS rejection only shows in the orderbook afterwards,
#     and _poll_fill_price() (core/rotation/executor.py) falls back to the
#     reference price -- so the pilot would have recorded ~20 positions
#     that never filled and marked the quarter done.
#
# Unhooked, not deleted: removed from quantos-token-refreshed.target and
# the timer is disabled. Before bringing it back, add a market-hours gate
# (NSE calendar) and record positions only on a confirmed fill; then
#   sudo systemctl enable --now quantos-rotation-pilot.timer
# and re-add the Wants= line to quantos-token-refreshed.target.
# Q3 2026 is still unrecorded in its state file -- a revived pilot will
# act on it immediately.
# ══════════════════════════════════════════════════════════════════════

[Unit]
Description=QuantOS Momentum Turnover Real-Capital Pilot (candidate 11 -- small bounded real orders, runs alongside the paper walk-forward)
After=network-online.target
Wants=network-online.target

# Ordering only, not a dependency: when quantos-token-refreshed.target
# pulls the whole batch in at once, this keeps the jobs single-file instead
# of letting them race. The VM has 956MB of RAM and no MemoryMax on any of
# these units, and on a quarter boundary the rotation jobs each fetch a
# few hundred symbol series at the same time the shortlist is fetching 500
# -- the exact shape of the 2026-07-15 OOM. Cheapest day-to-day too: the
# probe is ~5s and the rotation jobs no-op in ~2s off-boundary, so the
# shortlist still starts within seconds of the refresh.
# A failed or ExecCondition-skipped predecessor still releases the barrier.
After=quantos-orb-spread-probe.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/run_rotation_pilot.py
Environment=HOME=/home/ubuntu

# No Restart= here deliberately, same reasoning as quantos-rotation.service
# and quantos-paper-momentum.service: the most likely failure is a stale
# Fyers auth token, which needs a human to refresh interactively, not an
# immediate retry. Safe to fail silently more often than that, though,
# since core/rotation/pilot_executor.py's quarter-boundary gate makes
# today's failure recoverable by tomorrow's run without losing the quarter.
# No Telegram alert wired up in this first version (deliberately, matching
# quantos-paper-momentum.service's own scoping) -- check
# `journalctl -u quantos-rotation-pilot` during the existing daily VM
# check-in. rotation_pilot.enabled must ALSO be true in agent/config.yaml
# before this places any order, real or dry-run.
