[Unit]
Description=Fires the candidate 20 at-open window probe once daily, right after the real 09:15 IST candle closes

[Timer]
# Converted 2026-09-04 from a one-time 3x-same-day design to a recurring
# daily one -- the original plan (3 snapshots across the 09:15:30-09:18:00
# IST entry window) didn't actually happen as designed: each run takes
# ~2.5 minutes (30 candle checks + ~17 symbols x 2 legs of throttled
# option-chain calls), so the 2nd of 3 one-minute-apart fires got skipped
# and systemd coalesced it into a 3rd run starting the instant the 1st
# finished. Two same-day snapshots taken ~3 minutes apart turned out to be
# highly correlated anyway (most legs barely moved between them) -- the
# statistically useful axis is DAYS, not intra-window snapshots, so this
# now fires once per trading morning and accumulates across sessions
# instead (data_cache/goodnight_openwindow_probe.csv already appends,
# never dedupes -- no code change needed there).
#
# 09:16:05 IST = 03:46:05 UTC -- just after the 09:15 1-minute candle has
# closed (Fyers' history endpoint has no access to a still-forming candle,
# so this is the earliest a CLOSED candle read is possible -- see the
# probe script's own docstring). VM's systemd clock is Etc/UTC (confirmed
# via timedatectl), so this is written in UTC despite the strategy's own
# spec being IST-native -- same lesson learned the hard way earlier this
# session on quantos-orb-stopout-probe.timer.
#
# Fires daily regardless of NSE holidays -- not checked against
# core/reference/calendar.py (its derived window ends 2026-08-18, before
# any date this will fire on). A holiday fire is harmless: the probe finds
# no real 09:15 candle data and logs nothing useful, same self-healing
# tolerance every other probe in this project has for an off day.
OnCalendar=Mon..Fri *-*-* 03:46:05
Persistent=false

[Install]
WantedBy=timers.target
