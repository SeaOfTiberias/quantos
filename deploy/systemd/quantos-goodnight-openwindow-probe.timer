[Unit]
Description=Fires the candidate 20 at-open window probe 3x across the strategy's real 09:15:30-09:18:00 IST entry window, once, on 2026-09-04

[Timer]
# Three ONE-TIME absolute UTC timestamps (NOT a recurring Mon..Fri rule --
# this is a single feasibility check, not a production job). Same lesson
# learned the hard way earlier this session (quantos-orb-stopout-probe.
# timer): the VM's systemd clock runs in Etc/UTC (confirmed via
# timedatectl), so these are written in UTC, not IST, despite the
# strategy's own spec being IST-native.
#
# 09:16:05 IST = 03:46:05 UTC -- just after the 09:15 1-minute candle has
#   closed, close in spirit to the spec's "09:15:30" scan (Fyers' history
#   endpoint has no access to a still-forming candle, so this is the
#   earliest a CLOSED candle read is possible -- see the probe script's
#   own docstring for this disclosed simplification).
# 09:17:00 IST = 03:47:00 UTC -- mid-window.
# 09:18:00 IST = 03:48:00 UTC -- the spec's own entry-window close.
#
# Tomorrow (2026-09-04) is a Friday -- confirmed a weekday, NOT confirmed
# against the NSE holiday calendar (core/reference/calendar.py's derived
# window ends 2026-08-18, before this date -- see that module's own
# DateOutOfRange discipline). A holiday fire is harmless: the probe finds
# no real 09:15 candle data and logs nothing useful, same self-healing
# tolerance every other probe in this project has for an off day.
OnCalendar=2026-09-04 03:46:05
OnCalendar=2026-09-04 03:47:00
OnCalendar=2026-09-04 03:48:00
Persistent=false

[Install]
WantedBy=timers.target
