[Unit]
Description=Fires the Darvas ATR-Stop (Bucket B) EXECUTE phase once daily at 09:45 IST

[Timer]
# 04:15 UTC = 09:45 IST. Moved from 09:20 IST on 2026-09-25 (user decision)
# to stay clear of candidate 18/18b's opening-range minutes and their Fyers
# calls. Entries now land ~30 min after the open rather than at it -- a
# small, disclosed drift from the backtest's "next day's open" fill.
#
# The VM runs in Etc/UTC -- OnCalendar is evaluated in UTC, NOT IST.
OnCalendar=Mon..Fri *-*-* 04:15:00

# Catch up the same day after a brief VM outage; the .service's
# market-hours ExecCondition stops a catch-up after the close.
Persistent=true

[Install]
WantedBy=timers.target
