[Unit]
Description=QuantOS daily paper book -- walks the open books, reads the index and the book's stocks from the L1 map, a model decides cancels/guards/new book (validated by code), Telegrams the summary (paper only, no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
# Code-only since 2026-11-14 (user): Anthropic API credit is 0. The books are still walked,
# scored and Telegrammed; no model cancels/guards/new book. Remove --no-model to restore.
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/book_daily.py --no-model
Environment=HOME=/home/ubuntu
EnvironmentFile=/home/ubuntu/quantos/.env.cloud-api
TimeoutStartSec=3h
Nice=10
