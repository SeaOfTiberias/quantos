[Unit]
Description=QuantOS Darvas ATR-Stop (Bucket B) -- morning EXECUTE phase: places the orders in the evening scan's plan (gated by agent/config.yaml darvas_atr_stop.enabled/dry_run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quantos
ExecStart=/home/ubuntu/quantos/.venv/bin/python /home/ubuntu/quantos/scripts/run_darvas_atr_stop_live.py --phase execute
Environment=HOME=/home/ubuntu

# 2026-09-25: this unit is now ONLY the execute phase. The ~500-symbol
# history scan moved to quantos-darvas-atr-stop-scan.service (18:00 IST,
# post-market) because running it at 09:20 IST collided with candidate
# 18/18b's own Fyers calls (rate-limit errors most days 09-21..09-25).
# This phase reads ~/.quantos/darvas_atr_stop_plan.json and places only
# the orders it lists -- a handful of API calls on a typical day.
#
# Safety, unchanged: the script reads darvas_atr_stop.enabled FIRST and
# exits if false; dry_run:true logs intended orders instead of placing
# them; the user's own fresh capital go-ahead
# ([[feedback_confirm_before_scaling_capital]]) is the real gate for
# dry_run:false. The script also refuses a plan that is missing, already
# executed, or older than PLAN_MAX_AGE_DAYS.
#
# Market-hours ExecCondition (same pattern as quantos-orb-scalping-live):
# Persistent=true catch-up after a VM outage must never place MARKET
# orders after the 15:30 IST close. Known gap, shared with every unit on
# this VM: an NSE holiday that falls on a weekday is NOT detected
# (core/reference/calendar.py covers past sessions only).
ExecCondition=/bin/sh -c '[ "$(TZ=Asia/Kolkata date +%%u)" -le 5 ] && [ "$(TZ=Asia/Kolkata date +%%H%%M)" -ge 0915 ] && [ "$(TZ=Asia/Kolkata date +%%H%%M)" -le 1530 ]'

# No Restart= -- a re-fire the same day is a no-op by construction (the
# plan is marked executed_on after one run), and a missed day loses only
# that day's FRESH BREAKOUT entries; open positions are re-evaluated by
# that evening's scan.
