// QuantOS — Darvas ATR-Stop (Bucket B) STRATEGY — any-stock validator
// ──────────────────────────────────────────────────────────────────────────
// REWRITTEN 2026-09-25. The previous version of this file modelled the
// S7-3 intraday multi-timeframe confluence strategy (15m/1h/1D boxes,
// <=8% wide, stop = 15m box bottom) — the one S7-3 found NO edge in. It is
// in git history (a74521a) if ever needed. This file now ports the ONLY
// validated Darvas variant:
//   docs/DARVAS_ATR_STOP_BACKTEST_RESULTS.md, Bucket B —
//   mining PF 1.15 / Sharpe 0.68, holdout PF 1.16 / Sharpe 0.62.
//
// PURPOSE: the VM's 18:00 IST scan (scripts/run_darvas_atr_stop_live.py
// --phase scan) is the filter for our own universe (Nifty 500). This script
// is for VALIDATING ANY OTHER STOCK in TradingView's Strategy Tester — how
// the same rule has behaved on a name outside that universe. It places no
// real orders and is not wired to anything.
//
// Rule, ported from core/darvas/weekly_discovery.py (analyse_symbol,
// _detect_box, _atr) and scripts/backtest_darvas_atr_stop.py
// (_stop_from_atr, _simulate_exit_atr):
//   Box      weekly bars; ceiling = a weekly high not exceeded for 3
//            following weeks, floor = a weekly low not undercut for 3
//            following weeks; both confirmed -> box; then hunt the next.
//   Entry    daily close > ceiling + 0.1 x ATR(14), volume >= 1.5 x its
//            20-day SMA, previous close <= ceiling (a FRESH breakout), and
//            box width 35% < w <= 50% (Bucket B). Filled at next day's open.
//   Stop     ceiling - 2.0 x ATR(14) as of the breakout day.
//   Target   measured move: ceiling + (ceiling - floor).
//   Trail    whenever a HIGHER box confirms: stop -> new ceiling - 2 x ATR
//            (only if higher), target -> new measured move (only if higher).
//
// Known differences from the Python backtest (disclosed, all small):
//   - Python fills a stop/target exactly at the level even on a gap;
//     TradingView fills at the gap open (worse on stops, better on targets).
//   - Python builds weeks Mon-Fri ending Friday (pandas W-FRI); a rare
//     Saturday session (Budget / Muhurat) lands in a different week here.
//   - ATR seeding differs on the first ~50 bars of the chart only.
//   - Python's backtest allows overlapping trades in one stock; this allows
//     one position at a time (same as the live executor).
//   - No point-in-time index-membership filter (that is the point here).
//
// Costs: commission/slippage default to 0 — results are GROSS. Set them in
// the strategy's Properties tab for a net view.
//
// Usage: 1D chart only. Strategy Tester -> List of trades.
// Cross-check: ZYDUSLIFE should show a Bucket B breakout on 2026-09-25 with
// stop ~1124.27, target 1527.50, width 41.4% (the VM scan's first plan).

//@version=5
strategy("QuantOS Darvas ATR-Stop (Bucket B) — Validator", overlay=true,
     initial_capital=250000, currency=currency.INR,
     default_qty_type=strategy.percent_of_equity, default_qty_value=9,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=0, calc_on_every_tick=false, process_orders_on_close=false)

// ── Inputs (defaults = the validated, pre-registered values; changing them
// means you are no longer testing the strategy that passed) ──────────────
ceilBars   = input.int(3, "Weeks to confirm ceiling", minval=1)
floorBars  = input.int(3, "Weeks to confirm floor", minval=1)
atrLen     = input.int(14, "ATR period (daily)")
atrMultBo  = input.float(0.1, "Breakout buffer (x ATR above ceiling)")
volLen     = input.int(20, "Volume SMA period")
volMult    = input.float(1.5, "Volume surge multiplier")
atrStopMul = input.float(2.0, "Stop = ceiling - this x ATR")
minWidth   = input.float(35.0, "Bucket B min width % (exclusive)")
maxWidth   = input.float(50.0, "Bucket B max width % (inclusive)")
startDate  = input.time(timestamp("2015-01-01T00:00:00"), "Only enter on/after")

if not timeframe.isdaily
    runtime.error("Use a 1D (daily) chart — the rule is defined on daily bars with weekly boxes.")

// ── Weekly box engine: port of weekly_discovery._detect_box ──────────────
// Python rebuilds weekly bars from daily history every day, including the
// still-forming current week, and steps the machine once per week using
// the PREVIOUS (complete) week's high/low. This runs the same machine
// incrementally on daily bars: one step on the first bar of each week.
// After a confirmation Python resets the pending ceiling/floor to the
// CURRENT week's high/low — which is still forming — so here the pending
// values track that week's running high/low until the week ends.
var float wkHigh     = na
var float wkLow      = na
var int   weekCount  = 0
var float pendCeil   = na
var float pendFloor  = na
var int   ceilConf   = 0
var int   floorConf  = 0
var float boxCeil    = na
var float boxFloor   = na
var bool  pendIsLive = false   // pending ceiling/floor = the forming week

if timeframe.change("W") and not na(wkHigh)
    prevH = wkHigh
    prevL = wkLow
    pendIsLive := false
    weekCount += 1
    if na(pendCeil)
        pendCeil := prevH
        ceilConf := 0
    else if prevH <= pendCeil
        ceilConf += 1
    else
        pendCeil := prevH
        ceilConf := 0
    if na(pendFloor)
        pendFloor := prevL
        floorConf := 0
    else if prevL >= pendFloor
        floorConf += 1
    else
        pendFloor := prevL
        floorConf := 0
    wkHigh := high
    wkLow  := low
    if ceilConf >= ceilBars and floorConf >= floorBars
        boxCeil   := pendCeil
        boxFloor  := pendFloor
        ceilConf  := 0
        floorConf := 0
        pendIsLive := true
else
    wkHigh := na(wkHigh) ? high : math.max(wkHigh, high)
    wkLow  := na(wkLow)  ? low  : math.min(wkLow, low)

if pendIsLive
    pendCeil  := wkHigh
    pendFloor := wkLow

// ── Breakout: port of analyse_symbol's FRESH BREAKOUT test ───────────────
atr      = ta.atr(atrLen)
volSma   = ta.sma(volume, volLen)
volRatio = volSma > 0 ? volume / volSma : 0.0
hasBox   = not na(boxCeil) and boxFloor > 0
widthPct = hasBox ? (boxCeil - boxFloor) / boxFloor * 100 : na
enoughHistory = bar_index >= 59 and weekCount >= ceilBars + floorBars + 1

freshBreakout = hasBox and enoughHistory and widthPct <= 200
     and close > boxCeil + atr * atrMultBo and volRatio >= volMult
     and close[1] <= boxCeil
bucketB = freshBreakout and widthPct > minWidth and widthPct <= maxWidth

// ── Position management: port of _simulate_exit_atr ──────────────────────
var float stopLvl  = na
var float tgtLvl   = na
var float seenCeil = na

// Trail first (uses today's close-of-bar box state; an exit intrabar has
// already flattened the position, matching Python's check-then-trail order).
if strategy.position_size > 0 and hasBox and boxCeil > seenCeil
    newStop = boxCeil - atrStopMul * atr
    if newStop > stopLvl
        stopLvl  := newStop
        seenCeil := boxCeil
        newTgt = boxCeil + (boxCeil - boxFloor)
        if newTgt > tgtLvl
            tgtLvl := newTgt

if bucketB and strategy.position_size == 0 and time >= startDate
    stopLvl  := boxCeil - atrStopMul * atr
    tgtLvl   := boxCeil + (boxCeil - boxFloor)
    seenCeil := boxCeil
    if stopLvl > 0
        strategy.entry("Long", strategy.long)

if not na(stopLvl)
    strategy.exit("Exit", "Long", stop=stopLvl, limit=tgtLvl)

// ── Visuals ───────────────────────────────────────────────────────────────
plot(boxCeil,  "Box ceiling", color=color.new(color.green, 0), style=plot.style_stepline)
plot(boxFloor, "Box floor",   color=color.new(color.red, 40),  style=plot.style_stepline)
inPos = strategy.position_size > 0
plot(inPos ? stopLvl : na, "ATR stop", color=color.orange, style=plot.style_linebr, linewidth=2)
plot(inPos ? tgtLvl  : na, "Target",   color=color.aqua,   style=plot.style_linebr, linewidth=2)
plotshape(bucketB, "Bucket B breakout", shape.triangleup, location.belowbar, color.lime, size=size.normal)
plotshape(freshBreakout and not bucketB, "Breakout outside 35-50% (not traded)",
     shape.circle, location.belowbar, color.new(color.gray, 30), size=size.tiny)
